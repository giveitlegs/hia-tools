  "age_foundation": [
    {
      "topic": "older_homes",
      "text": "Older homes often have more issues, requiring the inspector to spend additional time in the house. For example, houses built before the 1980s may contain toxic materials such as asbestos or lead paint. Inspecting for these and similar issues can increase the fee by $100 to $200.",
      "low": 100,
      "high": 200,
      "source": "https://homeguide.com/costs/home-inspection-cost"
    },
    {
      "topic": "older_homes",
      "text": "Older homes often cost more to inspect because the inspector needs additional time to evaluate aging wiring, plumbing, and code compliance.",
      "source": "https://www.angi.com/articles/how-much-does-home-inspection-cost.htm"
    },
    {
      "topic": "crawlspace_basement",
      "text": "Houses with basements and crawl spaces will be more expensive to inspect because crawl spaces are tight areas and more difficult to reach. A basement or crawlspace means more square footage to cover and more to report on overall.",
      "source": "https://www.fixr.com/costs/home-inspection"
    },
    {
      "topic": "other_fees",
      "text": "Travel fees: inspectors may charge $1 to $2 per mile beyond 20 to 60 miles. Freestanding structures (guest houses, detached garages, barns) add $25 to $50 each.",
      "source": "https://homeguide.com/costs/home-inspection-cost"
    },
    {
      "topic": "hourly",
      "text": "A house inspection can cost from $80 to $150 per hour when billed by time.",
      "source": "https://www.fixr.com/costs/home-inspection"
    }
  ],
